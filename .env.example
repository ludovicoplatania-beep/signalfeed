SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
OPENAI_API_KEY=your-openai-api-key
# Generate at least 32 random characters. Vercel Cron sends it as Authorization: Bearer.
CRON_SECRET=replace-with-a-long-random-secret
# Single-user access. OWNER_USER_ID is the existing Supabase auth user UUID that owns your data.
OWNER_USER_ID=00000000-0000-4000-8000-000000000001
APP_PASSWORD=replace-with-a-strong-private-password
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
